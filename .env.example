# =============================================================================
# Environment Variables — Free-Templates.cc
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# 🔒 Never commit .env to version control. It's already in .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase Web SDK Configuration
# Find these in: Firebase Console → Project Settings → General → Your apps → Web
# -----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# Firebase Emulators (local development only)
# Set to true when running with `firebase emulators:start`
# -----------------------------------------------------------------------------
VITE_USE_FIREBASE_EMULATORS=false

# -----------------------------------------------------------------------------
# Firestore Data Source
# When true, the frontend will read templates from Firestore instead of mock data.
# Requires a running Firebase project or emulators.
# -----------------------------------------------------------------------------
VITE_USE_FIREBASE_DATA=false

# -----------------------------------------------------------------------------
# Stripe — frontend publishable key
# Used for redirecting to Stripe Checkout. Set this in production.
# Find it: Stripe Dashboard → Developers → API Keys
# -----------------------------------------------------------------------------
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY_HERE

# =============================================================================
# Firebase Cloud Functions Configuration
# These are NOT loaded from .env — they're set via Firebase Config.
# Run these commands in the `functions/` directory:
#
#   firebase functions:config:set stripe.secret_key="sk_live_..."
#   firebase functions:config:set stripe.webhook_secret="whsec_..."
#
# For local emulation, create a `functions/.env` file with:
#
#   STRIPE_SECRET_KEY=sk_test_...
#   STRIPE_WEBHOOK_SECRET=whsec_...
#
# ⚠ The VITE_-prefixed vars above are also used by the frontend at build time.
# =============================================================================
