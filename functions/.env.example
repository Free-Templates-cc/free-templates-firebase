# =============================================================================
# Functions — Local Stripe Emulation
# =============================================================================
# Copy this to .env for local Firebase emulator development:
#   cp .env.example .env
#
# 🔒 Never commit .env to version control.
# =============================================================================
#
# These are used ONLY by the Firebase Emulator Suite for local development.
# In production, set these via:
#
#   firebase functions:config:set stripe.secret_key="sk_live_..."
#   firebase functions:config:set stripe.webhook_secret="whsec_..."
#
# For the frontend, see the root .env for VITE_STRIPE_PUBLISHABLE_KEY.
#
# =============================================================================

# Stripe secret key (use test mode keys for emulation)
# Get yours at: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY_HERE

# Stripe webhook secret
# Get yours at: https://dashboard.stripe.com/test/webhooks
# (Create a webhook endpoint pointing to your local tunnel or use Stripe CLI)
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET_HERE
